#!/usr/bin/env python3
"""Keep the private snapshot and oversized ordinary blobs off the remote; then upload LFS."""
import subprocess
import sys

updates = sys.stdin.read()
snapshot = "715bac5"
for line in updates.splitlines():
    local_ref, commit, remote_ref, remote_sha = line.split()
    if commit == "0" * 40:
        continue
    snapshot_exists = subprocess.run(["git", "rev-parse", "--verify", snapshot + "^{commit}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if snapshot_exists and subprocess.run(["git", "merge-base", "--is-ancestor", snapshot, commit]).returncode == 0:
        raise SystemExit(f"Refusing to publish private working snapshot through {local_ref}")
    objects = subprocess.check_output(["git", "rev-list", "--objects", commit], text=True)
    sizes = subprocess.check_output(["git", "cat-file", "--batch-check=%(objecttype) %(objectsize) %(rest)"], input=objects, text=True)
    for item in sizes.splitlines():
        kind, size, *path = item.split(" ", 2)
        if kind == "blob" and int(size) > 100_000_000:
            raise SystemExit("Oversized non-LFS blob: " + item)
subprocess.run(["git", "lfs", "pre-push", *sys.argv[1:]], input=updates, text=True, check=True)
